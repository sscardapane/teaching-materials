{
  "latex-workshop.latex.recipe.default": "first",
  "latex-workshop.latex.outDir": "%WORKSPACE_FOLDER%/build/editor/%RELATIVE_DIR%",
  "latex-workshop.latex.recipes": [
    {
      "name": "Course deck (automatic engine)",
      "tools": [
        "course-deck"
      ]
    },
    {
      "name": "All decks of this course",
      "tools": [
        "course-all-decks"
      ]
    },
    {
      "name": "All NN and NNDS decks",
      "tools": [
        "every-deck"
      ]
    }
  ],
  "latex-workshop.latex.tools": [
    {
      "name": "course-deck",
      "command": "python3",
      "args": [
        "%WORKSPACE_FOLDER%/scripts/build.py",
        "--file",
        "%DOC_EXT%",
        "--outdir",
        "%OUTDIR%",
        "--synctex"
      ]
    },
    {
      "name": "course-all-decks",
      "command": "python3",
      "args": [
        "%WORKSPACE_FOLDER%/scripts/build.py",
        "--file",
        "%DOC_EXT%",
        "--whole-course",
        "--outdir-base",
        "%WORKSPACE_FOLDER%/build/editor/courses",
        "--synctex"
      ]
    },
    {
      "name": "every-deck",
      "command": "python3",
      "args": [
        "%WORKSPACE_FOLDER%/scripts/build.py",
        "all",
        "--outdir-base",
        "%WORKSPACE_FOLDER%/build/editor/courses",
        "--synctex"
      ]
    }
  ]
}
